-- FOLLOW TRAIL FE - HECKES 15 (ADJUSTABLE DISTANCE)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer
local C = {FollowMode=false, AutoRecord=true, ShowTrail=false}
local target, waypoints, lastRecordPos, followIdx, trailParts = nil, {}, nil, 1, {}
local RECORD_DIST = 8
local FOLLOW_SPEED = 18
local MAX_DIST = 2       -- bisa diubah dari GUI
local STOPPED = false

-- ===== INTRO =====
