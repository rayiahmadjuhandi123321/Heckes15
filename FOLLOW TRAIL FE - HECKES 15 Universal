    hdr.BackgroundColor3 = Color3.fromRGB(0, 180, 100); hdr.BorderSizePixel = 0
    Instance.new("UICorner", hdr).CornerRadius = UDim.new(0, 10)
    local ti = Instance.new("TextLabel", hdr); ti.Size = UDim2.new(1, 0, 1, 0)
    ti.BackgroundTransparency = 1; ti.Text = "FOLLOW TRAIL - Heckes 15"; ti.TextColor3 = Color3.new(1, 1, 1)
    ti.TextScaled = true; ti.Font = Enum.Font.GothamBold

    statusLbl = Instance.new("TextLabel", f); statusLbl.Size = UDim2.new(1, 0, 0, 22)
    statusLbl.Position = UDim2.new(0, 0, 0, 48); statusLbl.BackgroundTransparency = 1
    statusLbl.Text = "Target: Belum dipilih"; statusLbl.TextColor3 = Color3.fromRGB(255, 200, 0)
    statusLbl.TextScaled = true; statusLbl.Font = Enum.Font.GothamBold

    local listLbl = Instance.new("TextLabel", f); listLbl.Size = UDim2.new(1, 0, 0, 18)
    listLbl.Position = UDim2.new(0, 0, 0, 72); listLbl.BackgroundTransparency = 1
    listLbl.Text = "Pilih Player (klik nama):"; listLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
    listLbl.TextScaled = true; listLbl.Font = Enum.Font.Gotham

    playerList = Instance.new("ScrollingFrame", f); playerList.Size = UDim2.new(0.9, 0, 0, 130)
    playerList.Position = UDim2.new(0.05, 0, 0, 94); playerList.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    playerList.BorderSizePixel = 0; playerList.ScrollBarThickness = 4
    playerList.CanvasSize = UDim2.new(0, 0, 0, 0); playerList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Instance.new("UICorner", playerList).CornerRadius = UDim.new(0, 6)
    local ly = Instance.new("UIListLayout", playerList); ly.Padding = UDim.new(0, 4); ly.SortOrder = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", playerList); pad.PaddingTop = UDim.new(0, 5); pad.PaddingLeft = UDim.new(0, 5); pad.PaddingRight = UDim.new(0, 5)

    local function refreshList()
        for _, c in ipairs(playerList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                count = count + 1
                local b = Instance.new("TextButton", playerList); b.Size = UDim2.new(1, -10, 0, 28)
                b.BackgroundColor3 = Color3.fromRGB(50, 50, 70); b.BorderSizePixel = 0; b.Text = p.Name
                b.TextColor3 = Color3.new(1, 1, 1); b.TextScaled = true; b.Font = Enum.Font.Gotham
                b.LayoutOrder = count
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
                b.MouseButton1Click:Connect(function()
                    for _, c in ipairs(playerList:GetChildren()) do
                        if c:IsA("TextButton") then c.BackgroundColor3 = Color3.fromRGB(50, 50, 70) end
                    end
                    b.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
                    target = p
                    statusLbl.Text = "Target: " .. p.Name
                    statusLbl.TextColor3 = Color3.fromRGB(0, 255, 150)
                    waypoints = {}; lastRecordPos = nil; followIdx = 1; STOPPED = false
                    clearTrailVisual()
                end)
            end
        end
        if count == 0 then
            local e = Instance.new("TextLabel", playerList); e.Size = UDim2.new(1, -10, 0, 28)
            e.BackgroundTransparency = 1; e.Text = "Tidak ada player lain"
            e.TextColor3 = Color3.fromRGB(150, 150, 150); e.TextScaled = true; e.Font = Enum.Font.Gotham
        end
    end
    refreshList()
    Players.PlayerAdded:Connect(function() task.wait(0.5); refreshList() end)
    Players.PlayerRemoving:Connect(function(p)
        if target == p then
            target = nil; STOPPED = false
            statusLbl.Text = "Target: Belum dipilih"; statusLbl.TextColor3 = Color3.fromRGB(255,200,0)
        end
        task.wait(0.1); refreshList()
    end)

    local sc = Instance.new("ScrollingFrame", f); sc.Size = UDim2.new(1, -10, 0, 230)
    sc.Position = UDim2.new(0, 5, 0, 232); sc.BackgroundTransparency = 1; sc.BorderSizePixel = 0
    sc.ScrollBarThickness = 4; sc.CanvasSize = UDim2.new(0, 0, 0, 0)
    sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
    local ly2 = Instance.new("UIListLayout", sc); ly2.Padding = UDim.new(0, 5); ly2.SortOrder = Enum.SortOrder.LayoutOrder

    createToggle(sc, 1, "🚶 Follow Mode", "FollowMode", function(on)
        if on and not target then return false end
        if on then STOPPED = false; startFollow() else stopFollow() end
        return true
    end)
    createToggle(sc, 2, "📝 Auto Record", "AutoRecord", function(on)
        if on and not target then return false end
        if not on then lastRecordPos = nil end
        return true
    end)
    createToggle(sc, 3, "👁️ Show Trail", "ShowTrail", function(on)
        if not on then clearTrailVisual() end
        return true
    end)
    
    -- Distance control
    createDistanceControl(sc, 4)

    local clearBtn = Instance.new("TextButton", sc); clearBtn.Size = UDim2.new(1, -12, 0, 34)
    clearBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60); clearBtn.BorderSizePixel = 0
    clearBtn.Text = "🗑️ Clear Waypoints"; clearBtn.TextColor3 = Color3.new(1, 1, 1)
    clearBtn.TextScaled = true; clearBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", clearBtn).CornerRadius = UDim.new(0, 6)
    clearBtn.MouseButton1Click:Connect(function()
        waypoints = {}; lastRecordPos = nil; followIdx = 1; STOPPED = false; clearTrailVisual()
        print("[Follow] Waypoints dibersihkan!")
    end)

    local cls = Instance.new("TextButton", f); cls.Size = UDim2.new(0.9, 0, 0, 26)
    cls.Position = UDim2.new(0.05, 0, 1, -32); cls.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    cls.BorderSizePixel = 0; cls.Text = "▼ Sembunyikan GUI"; cls.TextColor3 = Color3.fromRGB(200, 200, 200)
    cls.TextScaled = true; cls.Font = Enum.Font.GothamBold
    Instance.new("UICorner", cls).CornerRadius = UDim.new(0, 6)
    cls.MouseButton1Click:Connect(function() mainGui.Enabled = false end)
end

-- ===== IKON =====
local function buildIcon()
    local ig = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
    ig.ResetOnSpawn = false; ig.DisplayOrder = 10
    local b = Instance.new("TextButton", ig); b.Size = UDim2.new(0, 52, 0, 52)
    b.Position = UDim2.new(0, 15, 0.5, -26); b.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
    b.BorderSizePixel = 0; b.Text = "H15"; b.TextColor3 = Color3.new(1, 1, 1)
    b.TextScaled = true; b.Font = Enum.Font.GothamBlack; b.AutoButtonColor = false; b.Active = true
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    local st = Instance.new("UIStroke", b); st.Color = Color3.new(1, 1, 1); st.Thickness = 2; st.Transparency = 0.3
    local dragging, dragStart, startPos, moved = false, nil, nil, false
    b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true; moved = false; dragStart = i.Position; startPos = b.Position end end)
    UIS.InputChanged:Connect(function(i) if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - dragStart
            if math.abs(d.X) > 8 or math.abs(d.Y) > 8 then moved = true end
            if moved then b.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end
        end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if dragging and not moved and mainGui then mainGui.Enabled = not mainGui.Enabled end
        dragging = false; moved = false end end)
end

