end

-- ===== HELPER =====
local function char() return LP.Character end
local function hrp() local c=char(); return c and c:FindFirstChild("HumanoidRootPart") end
local function hum() local c=char(); return c and c:FindFirstChildOfClass("Humanoid") end
local function targetHRP() return target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") end

local function clearTrailVisual()
    for _, p in ipairs(trailParts) do if p and p.Parent then p:Destroy() end end
    trailParts = {}
end

local function addWaypointVisual(pos)
    if not C.ShowTrail then return end
    local part = Instance.new("Part", workspace)
    part.Size = Vector3.new(1, 0.2, 1); part.Shape = Enum.PartType.Cylinder
    part.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
    part.Anchored = true; part.CanCollide = false
    part.Color = Color3.fromRGB(0, 255, 150); part.Material = Enum.Material.Neon
    part.Transparency = 0.3
    table.insert(trailParts, part)
    task.delay(8, function()
        if part and part.Parent then
            TweenService:Create(part, TweenInfo.new(1), {Transparency = 1}):Play()
            task.wait(1.1); part:Destroy()
        end
    end)
end

local function recordWaypoint(pos)
    if not lastRecordPos or (pos - lastRecordPos).Magnitude >= RECORD_DIST then
        table.insert(waypoints, pos)
        lastRecordPos = pos
        addWaypointVisual(pos)
        if #waypoints > 200 then table.remove(waypoints, 1) end
    end
end

local function stopMovement()
    local myHRP = hrp()
    if myHRP then
        local bv = myHRP:FindFirstChild("HeckesFollowBV")
        if bv then bv:Destroy() end
    end
end

local function moveTowards(myHRP, pos)
    local dir = (pos - myHRP.Position).Unit
    local bv = myHRP:FindFirstChild("HeckesFollowBV")
    if not bv then
        bv = Instance.new("BodyVelocity", myHRP)
        bv.Name = "HeckesFollowBV"
        bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
    end
    bv.Velocity = Vector3.new(dir.X * FOLLOW_SPEED, myHRP.Velocity.Y, dir.Z * FOLLOW_SPEED)
    local look = Vector3.new(pos.X, myHRP.Position.Y, pos.Z)
    myHRP.CFrame = CFrame.new(myHRP.Position, look)
end

-- ===== FOLLOW LOOP =====
local followConn
local function startFollow()
    if followConn then followConn:Disconnect() end
    followConn = RunService.Heartbeat:Connect(function()
        local h = hum()
        local myHRP = hrp()
        if not h or not myHRP then return end
        
        if C.AutoRecord and target then
            local tHRP = targetHRP()
            if tHRP then recordWaypoint(tHRP.Position) end
        end
        
        if not C.FollowMode then return end
        if not target then return end
        
        local tHRP = targetHRP()
        if not tHRP then stopMovement(); return end
        
        local distToTarget = (myHRP.Position - tHRP.Position).Magnitude
        
        if distToTarget <= MAX_DIST then
            if not STOPPED then
                stopMovement()
                STOPPED = true
            end
            return
        end
        
        STOPPED = false
        
        if #waypoints > 0 and followIdx <= #waypoints then
            local nextWP = waypoints[followIdx]
            local distWP = (myHRP.Position - nextWP).Magnitude
            
            if distWP < 2 then
                followIdx = followIdx + 1
            else
                local distFromWPToTarget = (nextWP - tHRP.Position).Magnitude
                if distFromWPToTarget > distToTarget + 5 then
                    followIdx = followIdx + 1
                else
                    moveTowards(myHRP, nextWP)
                    return
                end
            end
        end
        
        moveTowards(myHRP, tHRP.Position)
    end)
end

local function stopFollow()
    if followConn then followConn:Disconnect(); followConn = nil end
    stopMovement()
    STOPPED = false
end

-- ===== TOGGLE =====
local toggleRefs = {}
local function createToggle(parent, order, label, key, callback)
    local row = Instance.new("Frame", parent); row.Size = UDim2.new(1, -12, 0, 36)
    row.BackgroundColor3 = Color3.fromRGB(35, 35, 50); row.BorderSizePixel = 0; row.LayoutOrder = order
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    local lb = Instance.new("TextLabel", row); lb.Size = UDim2.new(0.65, 0, 1, 0); lb.Position = UDim2.new(0, 10, 0, 0)
    lb.BackgroundTransparency = 1; lb.Text = label; lb.TextColor3 = Color3.fromRGB(230, 230, 230)
    lb.TextScaled = true; lb.Font = Enum.Font.Gotham; lb.TextXAlignment = Enum.TextXAlignment.Left
    local sw = Instance.new("Frame", row); sw.Size = UDim2.new(0, 46, 0, 24); sw.Position = UDim2.new(1, -56, 0.5, -12)
    sw.BackgroundColor3 = Color3.fromRGB(80, 40, 40); sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame", sw); kn.Size = UDim2.new(0, 18, 0, 18); kn.Position = UDim2.new(0, 3, 0.5, -9)
    kn.BackgroundColor3 = Color3.new(1, 1, 1); kn.BorderSizePixel = 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local btn = Instance.new("TextButton", row); btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1; btn.Text = ""; btn.ZIndex = 5
    toggleRefs[key] = {sw = sw, kn = kn}
    local function setVisual(on)
        if on then
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 180, 80)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        else
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 40, 40)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        end
    end
    toggleRefs[key].setVisual = setVisual
    setVisual(C[key])
    btn.MouseButton1Click:Connect(function()
        local ns = not C[key]
        local ok, res = pcall(callback, ns)
        if ok and res ~= false then
            C[key] = ns; setVisual(ns)
            print("[Toggle] " .. label .. " -> " .. (ns and "ON" or "OFF"))
        else
            C[key] = false; setVisual(false)
            print("[Toggle] " .. label .. " GAGAL!")
        end
    end)
end

