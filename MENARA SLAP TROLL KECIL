local function ch() return LP.Character end
local function hum() local c=ch(); return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp() local c=ch(); return c and c:FindFirstChild("HumanoidRootPart") end

-- ===== TOOL ACTIVATE =====
local function getSlapTool()
    local c=ch(); if not c then return nil end
    for _,v in ipairs(c:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
    return nil
end

local function activateSlap()
    local tool=getSlapTool()
    if tool then
        pcall(function()
            tool:Activate()
        end)
        return true
    end
    return false
end

-- ===== AUTO SLAP AURA =====
local function startAutoSlap()
    if conns.slap then conns.slap:Disconnect() end
    conns.slap=RS.Heartbeat:Connect(function()
        if not C.AutoSlap then return end
        local mh=hrp(); if not mh then return end
        local tool=getSlapTool()
        if not tool then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                local th=p.Character:FindFirstChild("HumanoidRootPart")
                if th and (mh.Position-th.Position).Magnitude<12 then
                    pcall(function() tool:Activate() end)
                end
            end
        end
    end)
    return true
end
local function stopAutoSlap() if conns.slap then conns.slap:Disconnect(); conns.slap=nil end end

-- ===== REACH / HITBOX EXPANDER =====
local function startReach()
    if conns.reach then conns.reach:Disconnect() end
    conns.reach=RS.Heartbeat:Connect(function()
        if not C.Reach then return end
        local c=ch(); if not c then return end
        for _,v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then
                local h=v:FindFirstChild("Handle")
                if h then
                    h.Size=Vector3.new(8,8,8)
                    h.Transparency=0.5
                    h.CanCollide=false
                end
            end
        end
    end)
    return true
end
local function stopReach()
    if conns.reach then conns.reach:Disconnect(); conns.reach=nil end
    local c=ch(); if c then
        for _,v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then
                local h=v:FindFirstChild("Handle")
                if h then
                    h.Size=Vector3.new(1,1,1)
                    h.Transparency=0
                    h.CanCollide=true
                end
            end
        end
    end
end

-- ===== SLAP FLING =====
local function startSlapFling()
    if conns.fling then conns.fling:Disconnect() end
    conns.fling=RS.Heartbeat:Connect(function()
        if not C.SlapFling then return end
        local mh=hrp(); if not mh then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                local th=p.Character:FindFirstChild("HumanoidRootPart")
                if th and (mh.Position-th.Position).Magnitude<10 then
                    local bv=Instance.new("BodyVelocity",th)
                    bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                    bv.Velocity=Vector3.new(math.random(-200,200),200,math.random(-200,200))
                    game:GetService("Debris"):AddItem(bv,0.5)
                end
            end
        end
    end)
    return true
end
local function stopSlapFling() if conns.fling then conns.fling:Disconnect(); conns.fling=nil end end

-- ===== ANTI KNOCKBACK / GODMODE =====
local function startAntiKB()
    if conns.antikb then conns.antikb:Disconnect() end
    conns.antikb=RS.Heartbeat:Connect(function()
        if not C.AntiKB then return end
        local c=ch(); if not c then return end
        local h=hum()
        if h then pcall(function() h.Health=h.MaxHealth end) end
        for _,v in ipairs(c:GetDescendants()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity") or v:IsA("BodyGyro") then
                if v.Name~="H15Self" then v:Destroy() end
            end
        end
    end)
    return true
end
local function stopAntiKB() if conns.antikb then conns.antikb:Disconnect(); conns.antikb=nil end end

-- ===== INFINITE JUMP =====
local function startInfJump()
    if conns.jump then conns.jump:Disconnect() end
    conns.jump=UIS.JumpRequest:Connect(function()
        if not C.InfJump then return end
        local h=hum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    return true
end
local function stopInfJump()
    if conns.jump then conns.jump:Disconnect(); conns.jump=nil end
end

-- ===== TELEPORT TO TOP =====
local function teleportTop()
    local mh=hrp(); if not mh then return false end
    -- Cari part paling tinggi di workspace
    local highest=nil
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") and o.Anchored then
            if not highest or o.Position.Y>highest.Position.Y then
                highest=o
            end
        end
    end
    if highest then
        mh.CFrame=CFrame.new(highest.Position+Vector3.new(0,5,0))
        return true
    end
