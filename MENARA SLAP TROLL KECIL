-- ===== ESP =====
local function clearESP()
    for _,p in ipairs(P:GetPlayers()) do
        if p~=LP and p.Character then
            local e=p.Character:FindFirstChild("H15ESP")
            if e then e:Destroy() end
        end
    end
end
local function startESP()
    if conns.esp then conns.esp:Disconnect() end
    conns.esp=RS.Heartbeat:Connect(function()
        if not C.ESP then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                local h=p.Character:FindFirstChild("HumanoidRootPart")
                if h and not p.Character:FindFirstChild("H15ESP") then
                    local bb=Instance.new("BillboardGui",p.Character)
                    bb.Name="H15ESP"; bb.Size=UDim2.new(0,50,0,50)
                    bb.AlwaysOnTop=true; bb.Adornee=h
                    local fr=Instance.new("Frame",bb); fr.Size=UDim2.new(1,0,1,0)
                    fr.BackgroundTransparency=1
                    local st=Instance.new("UIStroke",fr)
                    st.Color=Color3.fromRGB(255,50,50); st.Thickness=2
                    local nm=Instance.new("TextLabel",bb); nm.Size=UDim2.new(1,0,0,16)
                    nm.Position=UDim2.new(0,0,1,2); nm.BackgroundTransparency=1
                    nm.Text=p.Name; nm.TextColor3=Color3.new(1,1,1)
                    nm.TextScaled=true; nm.Font=Enum.Font.GothamBold
                end
            end
        end
    end)
    return true
end
local function stopESP()
    if conns.esp then conns.esp:Disconnect(); conns.esp=nil end
    clearESP()
end

-- ===== ANTI AFK =====
local function startAntiAFK()
    if conns.afk then conns.afk:Disconnect() end
    conns.afk=RS.Heartbeat:Connect(function()
        if not C.AntiAFK then return end
        local vu=game:GetService("VirtualUser")
        vu:CaptureController(); vu:ClickButton2(Vector2.new())
    end)
    return true
end
local function stopAntiAFK()
    if conns.afk then conns.afk:Disconnect(); conns.afk=nil end
end

