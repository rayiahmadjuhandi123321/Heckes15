    local function sv(on)
        TS:Create(sw,TweenInfo.new(0.2),{BackgroundColor3=on and Color3.fromRGB(50,180,80) or Color3.fromRGB(80,40,40)}):Play()
        TS:Create(kn,TweenInfo.new(0.2),{Position=on and UDim2.new(1,-23,0.5,-10) or UDim2.new(0,3,0.5,-10)}):Play()
