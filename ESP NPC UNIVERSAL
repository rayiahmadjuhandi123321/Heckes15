local function ch() return LP.Character end
local function myHRP() local c=ch(); return c and c:FindFirstChild("HumanoidRootPart") end

local function isNPC(m)
    if not m or not m:IsA("Model") then return false end
    if not m:FindFirstChildOfClass("Humanoid") then return false end
    if P:GetPlayerFromCharacter(m) then return false end
    return true
end

local function getNPCHRP(m)
    return m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso") or m:FindFirstChild("Head")
end

-- Bikin ESP untuk 1 NPC
local function makeESP(npc)
    local hum=npc:FindFirstChildOfClass("Humanoid")
    local hrp=getNPCHRP(npc)
    if not hum or not hrp then return end
    
    -- Hapus ESP lama kalau ada
    local old=npc:FindFirstChild("HeckesESP")
    if old then old:Destroy() end
    
    local bb=Instance.new("BillboardGui",npc)
    bb.Name="HeckesESP"
    bb.Size=UDim2.new(0,100,0,80)
    bb.StudsOffset=Vector3.new(0,3,0)
    bb.AlwaysOnTop=true
    bb.Adornee=hrp
    activeESPs[npc]=bb
    
    -- Box outline
    if C.ShowBox then
        local box=Instance.new("Frame",bb)
        box.Name="Box"
        box.Size=UDim2.new(1,0,1,0)
        box.BackgroundTransparency=1
        box.BorderSizePixel=0
        local stroke=Instance.new("UIStroke",box)
        stroke.Color=Color3.fromRGB(255,50,50)
        stroke.Thickness=2
        stroke.Transparency=0.2
    end
    
    -- Nama
    if C.ShowName then
        local nm=Instance.new("TextLabel",bb)
        nm.Name="Name"
        nm.Size=UDim2.new(1,0,0,20)
        nm.Position=UDim2.new(0,0,0,-22)
        nm.BackgroundTransparency=1
        nm.Text=npc.Name
        nm.TextColor3=Color3.fromRGB(255,255,255)
        nm.TextScaled=true
        nm.Font=Enum.Font.GothamBold
        nm.TextStrokeTransparency=0
    end
    
    -- Health
    if C.ShowHealth then
        local hb=Instance.new("Frame",bb)
        hb.Name="HealthBG"
        hb.Size=UDim2.new(0.8,0,0,5)
        hb.Position=UDim2.new(0.1,0,1,2)
        hb.BackgroundColor3=Color3.fromRGB(50,50,50)
        hb.BorderSizePixel=0
        local hf=Instance.new("Frame",hb)
        hf.Name="HealthFill"
        hf.Size=UDim2.new(1,0,1,0)
        hf.BackgroundColor3=Color3.fromRGB(0,255,0)
        hf.BorderSizePixel=0
    end
    
    -- Distance
    if C.ShowDist then
        local ds=Instance.new("TextLabel",bb)
        ds.Name="Dist"
        ds.Size=UDim2.new(1,0,0,16)
        ds.Position=UDim2.new(0,0,1,8)
        ds.BackgroundTransparency=1
        ds.Text="0"
        ds.TextColor3=Color3.fromRGB(255,255,0)
        ds.TextScaled=true
        ds.Font=Enum.Font.GothamBold
        ds.TextStrokeTransparency=0
    end
end

-- Update ESP (loop)
local espConn
local function startESP()
    if espConn then espConn:Disconnect() end
    espConn=RS.Heartbeat:Connect(function()
        if not C.ESP then return end
        local mh=myHRP()
        
        -- Scan NPC
        for _,o in ipairs(workspace:GetDescendants()) do
            if isNPC(o) and not activeESPs[o] then
                makeESP(o)
            end
        end
        
        -- Update ESP yang ada
        for npc,bb in pairs(activeESPs) do
            if not npc.Parent or not bb.Parent then
                if bb.Parent then bb:Destroy() end
                activeESPs[npc]=nil
            else
                local hum=npc:FindFirstChildOfClass("Humanoid")
                local hrp=getNPCHRP(npc)
                if hum and hrp then
                    -- Update distance
                    if C.ShowDist and mh then
                        local d=bb:FindFirstChild("Dist")
                        if d then d.Text=math.floor((hrp.Position-mh.Position).Magnitude).."m" end
                    end
                    -- Update health bar
                    if C.ShowHealth then
                        local hb=bb:FindFirstChild("HealthBG")
                        if hb then
                            local hf=hb:FindFirstChild("HealthFill")
                            if hf then
                                local pct=math.clamp(hum.Health/hum.MaxHealth,0,1)
                                hf.Size=UDim2.new(pct,0,1,0)
                                hf.BackgroundColor3=pct>0.5 and Color3.fromRGB(0,255,0) or (pct>0.2 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,0,0))
                            end
                        end
                    end
                    -- Update warna box by distance
                    local box=bb:FindFirstChild("Box")
                    if box and mh then
                        local st=box:FindFirstChildOfClass("UIStroke")
                        if st then
                            local dist=(hrp.Position-mh.Position).Magnitude
                            st.Color=dist<50 and Color3.fromRGB(255,0,0) or (dist<200 and Color3.fromRGB(255,150,0) or Color3.fromRGB(255,255,0))
                        end
                    end
                end
            end
        end
    end)
end

local function clearESP()
    for npc,bb in pairs(activeESPs) do
        if bb and bb.Parent then bb:Destroy() end
    end
    activeESPs={}
end

local function stopESP()
    if espConn then espConn:Disconnect(); espConn=nil end
    clearESP()
end

