local function buildIcon()
    local ig=Instance.new("ScreenGui",LP:WaitForChild("PlayerGui"))
    ig.ResetOnSpawn=false; ig.DisplayOrder=10
    local b=Instance.new("TextButton",ig); b.Size=UDim2.new(0,52,0,52)
    b.Position=UDim2.new(0,15,0.5,-26); b.BackgroundColor3=Color3.fromRGB(0,200,120)
    b.BorderSizePixel=0; b.Text="👁"; b.TextColor3=Color3.new(1,1,1)
    b.TextScaled=true; b.Font=Enum.Font.GothamBlack; b.AutoButtonColor=false; b.Active=true
    Instance.new("UICorner",b).CornerRadius=UDim.new(1,0)
    local st=Instance.new("UIStroke",b); st.Color=Color3.new(1,1,1); st.Thickness=2; st.Transparency=0.3
    local dg,ds,sp,mv=false,nil,nil,false
    b.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        dg=true; mv=false; ds=i.Position; sp=b.Position end end)
    UIS.InputChanged:Connect(function(i) if not dg then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-ds
            if math.abs(d.X)>8 or math.abs(d.Y)>8 then mv=true end
            if mv then b.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y) end
        end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        if dg and not mv and mainGui then mainGui.Enabled=not mainGui.Enabled end
        dg=false; mv=false end end)
end

