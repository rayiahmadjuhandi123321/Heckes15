local function ch() return LP.Character end
local function hum() local c=ch(); return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp(m) m=m or ch(); return m and (m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")) end

-- ESP HELPER
local function clrESP(n)
    for _,p in ipairs(P:GetPlayers()) do
        if p~=LP and p.Character then local e=p.Character:FindFirstChild(n); if e then e:Destroy() end end
    end
end
local function mkESP(c,n,txt,col)
    local h=hrp(c); if not h then return end
    local bb=c:FindFirstChild(n)
    if not bb then
        bb=Instance.new("BillboardGui",c); bb.Name=n
        bb.Size=UDim2.new(0,70,0,70); bb.AlwaysOnTop=true
        local f=Instance.new("Frame",bb); f.Name="F"; f.Size=UDim2.new(1,0,1,0); f.BackgroundTransparency=1
        local s=Instance.new("UIStroke",f); s.Name="S"; s.Thickness=2
        local m=Instance.new("TextLabel",bb); m.Name="M"
        m.Size=UDim2.new(1,0,0,16); m.Position=UDim2.new(0,0,1,2)
        m.BackgroundTransparency=1; m.TextScaled=true; m.Font=Enum.Font.GothamBold; m.TextStrokeTransparency=0
    end
    bb.Adornee=h; bb.M.Text=txt; bb.M.TextColor3=col; bb.F.S.Color=col
end

-- LOOP HELPER
local function loop(name,fn)
    if conns[name] then conns[name]:Disconnect() end
    conns[name]=RS.Heartbeat:Connect(fn)
end
local function stopLoop(name) if conns[name] then conns[name]:Disconnect(); conns[name]=nil end end

-- MOVEMENT
local function flyFn()
    loop("fly",function()
        if not C.Fly then return end
        local m=hrp(); if not m then return end
        local bv=m:FindFirstChild("H15F") or Instance.new("BodyVelocity",m)
        bv.Name="H15F"; bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        local cam=workspace.CurrentCamera; local d=Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then d=d+cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then d=d-cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then d=d+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d=d-Vector3.new(0,1,0) end
        bv.Velocity=d*60
    end)
end
local function flyOff()
    stopLoop("fly")
    local m=hrp(); if m then local b=m:FindFirstChild("H15F"); if b then b:Destroy() end end
end
local function noclipFn()
    if conns.nc then conns.nc:Disconnect() end
    conns.nc=RS.Stepped:Connect(function()
        if not C.Noclip then return end
        local c=ch(); if not c then return end
        for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") and v.CanCollide then v.CanCollide=false end end
    end)
end
local function noclipOff()
    if conns.nc then conns.nc:Disconnect(); conns.nc=nil end
    local c=ch(); if c then for _,v in ipairs(c:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=true end end end
end
local function ijFn()
    if conns.ij then conns.ij:Disconnect() end
    conns.ij=UIS.JumpRequest:Connect(function()
        if not C.InfJump then return end
        local h=hum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end
local function ijOff() if conns.ij then conns.ij:Disconnect(); conns.ij=nil end end
local function awFn()
    loop("aw",function()
        if not C.AirWalk then return end
        local m=hrp(); if not m then return end
        if m.Velocity.Y<-3 then m.Velocity=Vector3.new(m.Velocity.X,0,m.Velocity.Z) end
    end)
end

-- VISUAL
local function pespFn()
    loop("pe",function()
        if not C.PlayerESP then return end
        local m=hrp()
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                local txt=p.Name
                if m then local t=hrp(p.Character); if t then txt=txt.." ["..math.floor((t.Position-m.Position).Magnitude).."m]" end end
                mkESP(p.Character,"H15E",txt,Color3.fromRGB(255,50,50))
            end
        end
    end)
end
local function pespOff() stopLoop("pe"); clrESP("H15E") end
local function chamsFn()
    loop("ch",function()
        if not C.Chams then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character and not p.Character:FindFirstChild("H15C") then
                local h=Instance.new("Highlight",p.Character); h.Name="H15C"
                h.FillColor=Color3.fromRGB(255,0,255); h.FillTransparency=0.5
                h.OutlineColor=Color3.fromRGB(255,255,0); h.OutlineTransparency=0
                h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
            end
        end
    end)
end
local function chamsOff()
    stopLoop("ch")
    for _,p in ipairs(P:GetPlayers()) do
        if p~=LP and p.Character then local e=p.Character:FindFirstChild("H15C"); if e then e:Destroy() end end
    end
end
local function skelFn()
    loop("sk",function()
        if not C.Skeleton then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                for _,pt in ipairs({"Head","UpperTorso","LowerTorso","LeftHand","RightHand","LeftFoot","RightFoot"}) do
                    local pp=p.Character:FindFirstChild(pt)
                    if pp and not pp:FindFirstChild("H15S") then
                        local bb=Instance.new("BillboardGui",pp); bb.Name="H15S"
                        bb.Size=UDim2.new(0,10,0,10); bb.AlwaysOnTop=true; bb.Adornee=pp
                        local f=Instance.new("Frame",bb); f.Size=UDim2.new(1,0,1,0)
                        f.BackgroundColor3=Color3.fromRGB(0,255,255); f.BorderSizePixel=0
                        Instance.new("UICorner",f).CornerRadius=UDim.new(1,0)
                    end
                end
            end
        end
    end)
end
local function skelOff()
    stopLoop("sk")
    for _,p in ipairs(P:GetPlayers()) do
        if p~=LP and p.Character then for _,o in ipairs(p.Character:GetDescendants()) do if o.Name=="H15S" then o:Destroy() end end end
    end
end
local function iespFn()
    loop("ie",function()
        if not C.ItemESP then return end
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Tool") and not o:FindFirstChild("H15I") then
                local bb=Instance.new("BillboardGui",o); bb.Name="H15I"
                bb.Size=UDim2.new(0,50,0,20); bb.AlwaysOnTop=true; bb.Adornee=o
                local m=Instance.new("TextLabel",bb); m.Size=UDim2.new(1,0,1,0)
                m.BackgroundTransparency=1; m.Text="📦 "..o.Name
                m.TextColor3=Color3.fromRGB(255,200,0); m.TextScaled=true
                m.Font=Enum.Font.GothamBold; m.TextStrokeTransparency=0
            end
        end
    end)
end
local function iespOff()
    stopLoop("ie")
    for _,o in ipairs(workspace:GetDescendants()) do local e=o:FindFirstChild("H15I"); if e then e:Destroy() end end
end

-- COMBAT
local function hbFn()
    loop("hb",function()
        if not C.Hitbox then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                for _,v in ipairs(p.Character:GetDescendants()) do
                    if v:IsA("BasePart") and (v.Name=="Head" or v.Name=="HumanoidRootPart" or v.Name=="Torso" or v.Name=="UpperTorso") then
                        pcall(function() v.Size=Vector3.new(8,8,8); v.Transparency=0.5; v.CanCollide=false end)
                    end
                end
            end
        end
    end)
end
local function faFn()
    loop("fa",function()
        if not C.FastAttack then return end
        local c=ch(); if not c then return end
        local t=c:FindFirstChildWhichIsA("Tool")
        if t then pcall(function() t:Activate() end) end
    end)
end

-- AUTO FARM
local function apFn()
    loop("ap",function()
        if not C.AutoPrompt then return end
        local m=hrp(); if not m then return end
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("ProximityPrompt") then
                local par=o.Parent
                if par and par:IsA("BasePart") and (par.Position-m.Position).Magnitude<30 then
                    pcall(function() fireproximityprompt(o) end)
                end
            end
        end
    end)
end
local function acFn()
    loop("ac",function()
        if not C.AutoClick then return end
        pcall(function() VU:CaptureController(); VU:ClickButton1(Vector2.new(0,0)) end)
    end)
end
local function colFn()
    loop("col",function()
        if not C.AutoCollect then return end
        local m=hrp(); if not m then return end
        for _,o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and (o.Name:lower():find("coin") or o.Name:lower():find("cash") or o.Name:lower():find("gem")) then
                if (o.Position-m.Position).Magnitude<50 then pcall(function() m.CFrame=CFrame.new(o.Position+Vector3.new(0,2,0)) end) end
            end
        end
    end)
end

-- TROLL
local function sbFn()
    loop("sb",function()
        if not C.SpinBot then return end
        local m=hrp(); if not m then return end
        m.CFrame=m.CFrame*CFrame.Angles(0,math.rad(45),0)
    end)
end
local function flingOne(p)
    if not p or not p.Character then return end
    local t=hrp(p.Character); if not t then return end
    pcall(function()
        local bv=Instance.new("BodyVelocity",t)
        bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        bv.Velocity=Vector3.new(math.random(-500,500),math.random(300,600),math.random(-500,500))
        local bg=Instance.new("BodyAngularVelocity",t)
        bg.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
        bg.AngularVelocity=Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))
        game:GetService("Debris"):AddItem(bv,0.4); game:GetService("Debris"):AddItem(bg,0.4)
    end)
end
local function tfFn()
    loop("tf",function()
        if not C.TouchFling then return end
        local m=hrp(); if not m then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP and p.Character then
                local t=hrp(p.Character)
                if t and (m.Position-t.Position).Magnitude<6 then flingOne(p) end
            end
        end
    end)
end
local function invisFn(on)
    local c=ch(); if not c then return false end
    for _,v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") and v.Name~="HumanoidRootPart" then v.Transparency=on and 1 or 0 end
        if v:IsA("Decal") or v:IsA("Texture") then v.Transparency=on and 1 or 0 end
    end
    return true
end

-- SERVER
local function afkFn()
    loop("afk",function()
        if not C.AntiAFK then return end
        pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new()) end)
    end)
end
local function giveBtools()
    local bp=LP:FindFirstChild("Backpack"); if not bp then return false end
    for _,n in ipairs({"Grab","Clone","Hammer"}) do
        pcall(function() local t=Instance.new("HopperBin",bp); t.BinType=Enum.BinType[n] end)
    end
    return true
end
local function load2(url,name)
    local ok=pcall(function() loadstring(game:HttpGet(url))() end)
    if ok then Rayfield:Notify({Title="✅",Content=name.." loaded!",Duration=4})
    else Rayfield:Notify({Title="❌",Content=name.." gagal",Duration=5}) end
end

