local toggleRefs = {}
local function createToggle(parent, order, label, getState, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -12, 0, 46)
    row.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    row.BorderSizePixel = 0
