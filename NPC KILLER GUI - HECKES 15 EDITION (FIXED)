    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lb = Instance.new("TextLabel", row)
    lb.Size = UDim2.new(0.65, 0, 1, 0)
    lb.Position = UDim2.new(0, 10, 0, 0)
    lb.BackgroundTransparency = 1
    lb.Text = label
    lb.TextColor3 = Color3.fromRGB(230, 230, 230)
    lb.TextScaled = true
    lb.Font = Enum.Font.GothamBold
    lb.TextXAlignment = Enum.TextXAlignment.Left

    local sw = Instance.new("Frame", row)
    sw.Size = UDim2.new(0, 50, 0, 26)
    sw.Position = UDim2.new(1, -60, 0.5, -13)
    sw.BackgroundColor3 = Color3.fromRGB(80, 40, 40)
    sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local kn = Instance.new("Frame", sw)
    kn.Size = UDim2.new(0, 20, 0, 20)
    kn.Position = UDim2.new(0, 3, 0.5, -10)
    kn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    kn.BorderSizePixel = 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 5

    local function setVisual(state)
        if state then
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 180, 80)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
        else
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 40, 40)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
        end
    end

    toggleRefs[label] = {setVisual = setVisual}
    setVisual(getState())

    btn.MouseButton1Click:Connect(function()
        local newState = not getState()
        local ok, result = pcall(callback, newState)
        if ok and result ~= false then
            setVisual(newState)
            print("[Toggle] " .. label .. " -> " .. (newState and "ON" or "OFF"))
        else
            setVisual(false)
            print("[Toggle] " .. label .. " GAGAL!")
        end
    end)
end

