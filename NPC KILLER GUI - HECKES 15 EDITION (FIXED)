-- ==================== FUNGSI KILL ====================
local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function getNearbyNPCs()
    local npcs = {}
    local myChar = LocalPlayer.Character
    if not myChar then return npcs end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        or myChar:FindFirstChild("UpperTorso")
        or myChar:FindFirstChild("Torso")
    if not myHRP then return npcs end

    local myPos = myHRP.Position
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChild("UpperTorso")
                or obj:FindFirstChild("Torso")
            if hrp then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= CONFIG.Range then
                    table.insert(npcs, {
                        model = obj,
                        humanoid = obj:FindFirstChildOfClass("Humanoid"),
                        hrp = hrp
                    })
                end
            end
        end
    end
    return npcs
end

local function killNPC(npc)
    if not npc or not npc.humanoid then return end
    if npc.humanoid.Health <= 0 then return end

    local now = tick()
    if now - (lastAttack[npc.model] or 0) < CONFIG.Cooldown then return end
    lastAttack[npc.model] = now

    -- 3 lapis metode kill
    pcall(function()
        npc.humanoid.Health = npc.humanoid.Health - CONFIG.Damage
    end)
    if npc.humanoid.Health > 0 then
        pcall(function() npc.humanoid:TakeDamage(CONFIG.Damage) end)
    end
    if npc.humanoid.Health > 0 then
        pcall(function() npc.humanoid.Health = 0 end)
    end

    -- Efek visual
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 0)
    hl.FillTransparency = 0.3
    hl.Parent = npc.model
    Debris:AddItem(hl, 0.2)
end

local loopConn
local function startKillerLoop()
    if loopConn then loopConn:Disconnect() end
    loopConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.Enabled then return end
        local npcs = getNearbyNPCs()
        for _, npc in ipairs(npcs) do
            killNPC(npc)
        end
    end)
end

local function stopKillerLoop()
    if loopConn then loopConn:Disconnect(); loopConn = nil end
end

