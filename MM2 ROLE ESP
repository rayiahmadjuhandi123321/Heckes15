-- ===== FUNGSI ROLE =====
local function getRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")
    -- Cek Murderer (pegang knife)
    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murderer"
    end
    -- Cek Sheriff (pegang gun)
    if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("Revolver"))) then
        return "Sheriff"
    end
    return "Innocent"
end

local function getRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255,0,0)
    elseif role == "Sheriff" then return Color3.fromRGB(0,100,255)
    else return Color3.fromRGB(0,255,0) end
end

-- ===== ESP =====
local function clearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local old = p.Character:FindFirstChild("HeckesESP")
            if old then old:Destroy() end
        end
    end
    if espFolder then espFolder:Destroy(); espFolder = nil end
end

local function updateESP()
    if not C.MurdererESP and not C.SheriffESP and not C.InnocentESP then
        clearESP(); return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local role = getRole(p)
            local show = (role == "Murderer" and C.MurdererESP) or (role == "Sheriff" and C.SheriffESP) or (role == "Innocent" and C.InnocentESP)
            local old = p.Character:FindFirstChild("HeckesESP")
            if old then old:Destroy() end
            if hrp and show then
                local color = getRoleColor(role)
                local bb = Instance.new("BillboardGui", p.Character); bb.Name = "HeckesESP"
                bb.Size = UDim2.new(0, 60, 0, 60); bb.AlwaysOnTop = true; bb.Adornee = hrp
                local fr = Instance.new("Frame", bb); fr.Size = UDim2.new(1, 0, 1, 0)
                fr.BackgroundTransparency = 1
                local st = Instance.new("UIStroke", fr); st.Color = color; st.Thickness = 2
                local nm = Instance.new("TextLabel", bb); nm.Size = UDim2.new(1, 0, 0, 18)
                nm.Position = UDim2.new(0, 0, 1, 2); nm.BackgroundTransparency = 1
                nm.Text = role .. " | " .. p.Name; nm.TextColor3 = color
                nm.TextScaled = true; nm.Font = Enum.Font.GothamBold; nm.TextStrokeTransparency = 0
            end
        end
    end
end

-- ===== NOTIFIKASI =====
local function setupNotif()
    notifGui = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
    notifGui.Name = "MM2Notif"; notifGui.ResetOnSpawn = false; notifGui.DisplayOrder = 100
end

local function sendNotif(text, color)
    if not notifGui then return end
    local fr = Instance.new("Frame", notifGui)
    fr.Size = UDim2.new(0, 250, 0, 40); fr.Position = UDim2.new(0.5, -125, 0, 60)
    fr.BackgroundColor3 = Color3.fromRGB(20, 20, 30); fr.BorderSizePixel = 0
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 8)
    local st = Instance.new("UIStroke", fr); st.Color = color; st.Thickness = 2
    local tl = Instance.new("TextLabel", fr); tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1; tl.Text = text; tl.TextColor3 = color
    tl.TextScaled = true; tl.Font = Enum.Font.GothamBold
    task.spawn(function()
        TweenService:Create(fr, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -125, 0, 110)}):Play()
        task.wait(3)
        TweenService:Create(fr, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(tl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        task.wait(0.4); fr:Destroy()
    end)
end

-- Loop cek role berubah
task.spawn(function()
    while task.wait(1) do
        if not C.Notif then continue end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local role = getRole(p)
                if lastRoles[p] and lastRoles[p] ~= role then
                    sendNotif(p.Name .. " -> " .. role, getRoleColor(role))
                end
                lastRoles[p] = role
            end
        end
        -- Cek Murderer & Sheriff baru
        local murderer, sheriff = nil, nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local r = getRole(p)
                if r == "Murderer" then murderer = p end
                if r == "Sheriff" then sheriff = p end
            end
        end
        if murderer and not lastRoles["_murderer"] then
            sendNotif("🔪 Murderer: " .. murderer.Name, Color3.fromRGB(255,0,0))
        end
        if sheriff and not lastRoles["_sheriff"] then
            sendNotif("🔫 Sheriff: " .. sheriff.Name, Color3.fromRGB(0,100,255))
        end
        lastRoles["_murderer"] = murderer
        lastRoles["_sheriff"] = sheriff
    end
end)

-- ===== TOGGLE =====
local toggleRefs = {}
local function createToggle(parent, order, label, key, callback)
    local row = Instance.new("Frame", parent); row.Size = UDim2.new(1, -12, 0, 36)
    row.BackgroundColor3 = Color3.fromRGB(35, 35, 50); row.BorderSizePixel = 0; row.LayoutOrder = order
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    local lb = Instance.new("TextLabel", row); lb.Size = UDim2.new(0.65, 0, 1, 0); lb.Position = UDim2.new(0, 10, 0, 0)
    lb.BackgroundTransparency = 1; lb.Text = label; lb.TextColor3 = Color3.fromRGB(230, 230, 230)
    lb.TextScaled = true; lb.Font = Enum.Font.Gotham; lb.TextXAlignment = Enum.TextXAlignment.Left
    local sw = Instance.new("Frame", row); sw.Size = UDim2.new(0, 46, 0, 24); sw.Position = UDim2.new(1, -56, 0.5, -12)
    sw.BackgroundColor3 = Color3.fromRGB(80, 40, 40); sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local kn = Instance.new("Frame", sw); kn.Size = UDim2.new(0, 18, 0, 18); kn.Position = UDim2.new(0, 3, 0.5, -9)
    kn.BackgroundColor3 = Color3.new(1, 1, 1); kn.BorderSizePixel = 0
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)
    local btn = Instance.new("TextButton", row); btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1; btn.Text = ""; btn.ZIndex = 5
    toggleRefs[key] = {sw = sw, kn = kn}
    local function setVisual(on)
        if on then
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 180, 80)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        else
            TweenService:Create(sw, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 40, 40)}):Play()
            TweenService:Create(kn, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        end
    end
    toggleRefs[key].setVisual = setVisual
    setVisual(C[key])
    btn.MouseButton1Click:Connect(function()
        local ns = not C[key]
        local ok, res = pcall(callback, ns)
        if ok and res ~= false then
            C[key] = ns; setVisual(ns)
            print("[Toggle] " .. label .. " -> " .. (ns and "ON" or "OFF"))
        else
            C[key] = false; setVisual(false)
            print("[Toggle] " .. label .. " GAGAL!")
        end
    end)
end

