-- ==================== IKON BULAT DRAGGABLE ====================
local function createIcon()
    local iconGui = Instance.new("ScreenGui")
    iconGui.Name = "AuraIcon"
    iconGui.ResetOnSpawn = false
    iconGui.DisplayOrder = 10
    iconGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local iconButton = Instance.new("TextButton", iconGui)
    iconButton.Size = UDim2.new(0, 55, 0, 55)
    iconButton.Position = UDim2.new(0, 20, 0.5, -27)
    iconButton.BackgroundColor3 = Color3.fromRGB(0, 200, 120)
    iconButton.BorderSizePixel = 0
    iconButton.Text = "H15"
    iconButton.TextColor3 = Color3.new(1, 1, 1)
    iconButton.TextScaled = true
    iconButton.Font = Enum.Font.GothamBlack
    iconButton.AutoButtonColor = false
    iconButton.Active = true
    Instance.new("UICorner", iconButton).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", iconButton)
    stroke.Color = Color3.new(1, 1, 1)
    stroke.Thickness = 2
    stroke.Transparency = 0.3

    -- State drag
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local moved = false
    local CLICK_THRESHOLD = 8

    iconButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = iconButton.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > CLICK_THRESHOLD or math.abs(delta.Y) > CLICK_THRESHOLD then
                moved = true
            end
            if moved then
                iconButton.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                if not moved then
                    if mainScreenGui then
                        mainScreenGui.Enabled = not mainScreenGui.Enabled
                        print("[Aura] GUI " .. (mainScreenGui.Enabled and "DIBUKA" or "DITUTUP"))
                    end
                end
                dragging = false
                moved = false
            end
        end
    end)
end

