-- ==================== FUNGSI AURA ====================
local function clearAura()
    for _, obj in ipairs(auraObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    auraObjects = {}

    if trailObject then
        trailObject:Destroy()
        trailObject = nil
    end
    if highlightObject then
        highlightObject:Destroy()
        highlightObject = nil
    end
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end
end

local function createAura()
    clearAura()

    local char = LocalPlayer.Character
    if not char then
        warn("[Aura] Karakter tidak ditemukan!")
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        warn("[Aura] HumanoidRootPart tidak ditemukan!")
        return
    end

    local color = CONFIG.AuraColor

    -- ===== PARTIKEL AURA =====
    local particle = Instance.new("ParticleEmitter")
    particle.Name = "HeckesAuraParticle"
    particle.Texture = "rbxassetid://243098098" -- partikel bulat glow
    particle.Color = ColorSequence.new(color)
    particle.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 1.5 * CONFIG.AuraIntensity),
        NumberSequenceKeypoint.new(1, 0)
    })
    particle.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.2, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    particle.Lifetime = NumberRange.new(0.8, 1.5)
    particle.Rate = 40 * CONFIG.AuraIntensity
    particle.Speed = NumberRange.new(2, 6)
    particle.SpreadAngle = Vector2.new(180, 180)
    particle.EmissionDirection = Enum.NormalId.Top
    particle.LightEmission = 1
    particle.LightInfluence = 0
    particle.Parent = hrp
    table.insert(auraObjects, particle)

    -- ===== PARTIKEL KEDUA (orbit) =====
    local particle2 = Instance.new("ParticleEmitter")
    particle2.Name = "HeckesAuraOrbit"
    particle2.Texture = "rbxassetid://243098098"
    particle2.Color = ColorSequence.new(Color3.new(1, 1, 1))
    particle2.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.8),
        NumberSequenceKeypoint.new(1, 0)
    })
    particle2.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.3, 0.4),
        NumberSequenceKeypoint.new(1, 1)
    })
    particle2.Lifetime = NumberRange.new(0.5, 1)
    particle2.Rate = 20 * CONFIG.AuraIntensity
    particle2.Speed = NumberRange.new(4, 8)
    particle2.SpreadAngle = Vector2.new(360, 360)
    particle2.LightEmission = 1
    particle2.LightInfluence = 0
    particle2.Parent = hrp
    table.insert(auraObjects, particle2)

    -- ===== TRAIL =====
    if CONFIG.TrailEnabled then
        local attachment0 = Instance.new("Attachment")
        attachment0.Name = "AuraTrail0"
        attachment0.Position = Vector3.new(0, 1, 0)
        attachment0.Parent = hrp
        table.insert(auraObjects, attachment0)

        local attachment1 = Instance.new("Attachment")
        attachment1.Name = "AuraTrail1"
        attachment1.Position = Vector3.new(0, -1, 0)
        attachment1.Parent = hrp
        table.insert(auraObjects, attachment1)

        local trail = Instance.new("Trail")
        trail.Name = "HeckesAuraTrail"
        trail.Attachment0 = attachment0
        trail.Attachment1 = attachment1
        trail.Color = ColorSequence.new(color)
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1)
        })
        trail.Lifetime = 0.6
        trail.LightEmission = 1
        trail.Parent = hrp
        trailObject = trail
    end

    -- ===== HIGHLIGHT (glow) =====
    if CONFIG.GlowEnabled then
        local highlight = Instance.new("Highlight")
        highlight.Name = "HeckesAuraHighlight"
        highlight.FillColor = color
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.OutlineTransparency = 0.3
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char
        highlightObject = highlight
    end

    -- ===== POINT LIGHT =====
    local light = Instance.new("PointLight")
    light.Name = "HeckesAuraLight"
    light.Color = color
    light.Brightness = 3 * CONFIG.AuraIntensity
    light.Range = 15
    light.Parent = hrp
    table.insert(auraObjects, light)

    -- ===== ANIMASI ROTASI PARTIKEL =====
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.AuraEnabled then return end
        local currentChar = LocalPlayer.Character
        if not currentChar or not currentChar:FindFirstChild("HumanoidRootPart") then return end
        
        local t = tick() * 3
        for _, obj in ipairs(auraObjects) do
            if obj and obj:IsA("ParticleEmitter") then
                obj.Rotation = NumberRange.new(math.deg(t) % 360, (math.deg(t) % 360) + 180)
            end
        end
    end)

    print("[Aura] ✅ Aura Hacker aktif! Warna: " .. tostring(color))
end

